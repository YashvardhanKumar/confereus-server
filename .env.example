# MongoDB Configuration
# To use local containerized MongoDB with replica set (Change Streams support):
MONGO_URI=mongodb://mongodb:27017/confereus?replicaSet=rs0
# Or to use MongoDB Atlas:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/confereus?retryWrites=true&w=majority

# Email Notifications (used by API and Notification Worker)
FROM_NAME=Confereus
FROM_EMAIL=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Auth & LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
REDIRECT_URL=https://confereus.codeflip.co.in/signin-linkedin
SCOPE=r_liteprofile%20r_emailaddress
STATE=123456

# Optional RSA Keys (if not using keys/rsa.key and keys/rsa.key.pub)
# PRIVATE_KEY=
# PUBLIC_KEY=

# Worker Settings
WORKER_POLL_INTERVAL_MS=30000

# CORS Allowed Origins
ALLOWED_ORIGINS=*
